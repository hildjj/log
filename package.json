{
  "name": "@cto.af/log",
  "version": "2.0.1",
  "decription": "A thin wrapper around Pino to help isolate its changes from other projects",
  "main": "lib/index.js",
  "files": [
    "lib/*"
  ],
  "type": "module",
  "keywords": [
    "logging",
    "pino"
  ],
  "author": "Joe Hildebrand <joe-github@cursive.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cto-af/log.git"
  },
  "homepage": "https://github.com/cto-af/log#readme",
  "bugs": {
    "url": "https://github.com/cto-af/log/issues"
  },
  "scripts": {
    "clean": "rm -rf coverage docs lib",
    "lint": "eslint .",
    "pretest": "npm run ts -- --inlineSourceMap",
    "test": "c8 node --enable-source-maps --test",
    "posttest": "npm run ts",
    "docs": "typedoc",
    "ts": "tsc",
    "build": "npm run test && npm run lint && npm run docs && npm pack --dry-run"
  },
  "dependencies": {
    "@cto.af/utils": "~2.0.1",
    "pino": "~10.4.0",
    "pino-pretty": "~13.2.0"
  },
  "devDependencies": {
    "@cto.af/eslint-config": "^7.0.3",
    "@eslint/markdown": "^8.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint": "^10.12.0",
    "superc8": "^12.7.0",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  }
}
